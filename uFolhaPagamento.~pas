function TfrFolhaPagamento.fCalcularIrrf: Currency;
var
  wBaseCalculo: Currency;
begin
  wBaseCalculo := wTotalProventos - wInss;

  if wBaseCalculo <= 2428.80 then
     Result := 0

  else if wBaseCalculo <= 2826.65 then
     Result := (wBaseCalculo * 0.075) - 182.16

  else if wBaseCalculo <= 3751.05 then
     Result := (wBaseCalculo * 0.15) - 394.16

  else if wBaseCalculo <= 4664.68 then
     Result := (wBaseCalculo * 0.225) - 675.49

  else
     Result := (wBaseCalculo * 0.275) - 908.73;

  if Result < 0 then
     Result := 0;
end;

function TfrFolhaPagamento.fExisteFolhaFuncionario: Boolean;
begin
  Result := False;

  cdsFolhaPagamento.First;

  while not cdsFolhaPagamento.Eof do
  begin
    if cdsFolhaPagamentobdCODIGOFUNCIONARIO.AsInteger =
       cdsFuncionariobdCODIGOFUNCIONARIO.AsInteger then
    begin
      Result := True;
      Exit;
    end;

    cdsFolhaPagamento.Next;
  end;
end;

