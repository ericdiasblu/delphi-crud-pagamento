function TfrFolhaPagamento.fExisteFolhaFuncionarioMesAno: Boolean;
begin
  Result := False;

  cdsFolhaPagamento.First;

  while not cdsFolhaPagamento.Eof do
  begin
    if (cdsFolhaPagamentobdCODIGOFUNCIONARIO.AsInteger = cdsFuncionariobdCODIGOFUNCIONARIO.AsInteger)
       and (cdsFolhaPagamentobdMES.AsString = cbMes.Text)
       and (cdsFolhaPagamentobdANO.AsString = edAno.Text)
       and (cdsFolhaPagamentobdCODIGO.AsInteger <> StrToIntDef(edCodigo.Text, 0)) then
    begin
      Result := True;
      Exit;
    end;

    cdsFolhaPagamento.Next;
  end;
end;

